<?xml version="1.0" encoding="utf-8"?>
<!-- Fully transparent — used only to suppress Android 12+'s mandatory splash
     screen icon (see themes.xml's windowSplashScreenAnimatedIcon). The
     platform always shows *some* splash frame on a cold launch for API 31+;
     it cannot be fully disabled, only made to render nothing visible. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@android:color/transparent" />
</shape>
