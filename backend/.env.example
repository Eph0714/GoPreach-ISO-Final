# Copy to .env on the server (never commit .env).
NODE_ENV=production
PORT=3000

# MySQL (create the database + user in hPanel > Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Logins stay on Firebase Auth at first: the server only VERIFIES Firebase ID tokens (public keys, no secret needed).
FIREBASE_PROJECT_ID=gopreach-957a6

# "memory" = no database (local tests only). Production must use "mysql".
STORE=mysql
