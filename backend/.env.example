# Copy to .env on the server (never commit .env).
NODE_ENV=production
PORT=3000

# MySQL (create the database + user in hPanel > Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Logins stay on Firebase Auth at first: the server only VERIFIES Firebase ID tokens (public keys, no secret needed).
FIREBASE_PROJECT_ID=gopreach-957a6

# "memory" = no database (local tests only). Production must use "mysql".
STORE=mysql

# Passkeys (WebAuthn). Without PASSKEY_RP_ID + ANDROID_CERT_SHA256 the passkey routes answer 503.
PASSKEY_RP_ID=gopreach.sinaglahinv.com
ANDROID_PACKAGE=com.emfitsolutions.gopreach
# SHA-256 of the key the APK is signed with; several allowed, comma-separated (debug and release differ).
ANDROID_CERT_SHA256=D2:5B:E9:DB:B5:1B:CF:1F:BF:B7:36:8B:75:8C:AE:DF:CD:BD:97:E0:F0:C3:87:07:D2:55:96:B3:CA:F7:E7:78

# Voice Notes & Meeting Minutes (speech-to-text + AI minutes). Without OPENAI_API_KEY the voice routes answer 503 and recordings simply wait.
# The key lives ONLY here on the server, never in the app. Models can be changed without touching code.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_MINUTES_MODEL=gpt-4o-mini
# The GoPreach website may offer passkeys too: list its https origin(s), comma-separated. Its host must end with PASSKEY_RP_ID.
# PASSKEY_WEB_ORIGINS=https://web.gopreach.sinaglahinv.com
